# Local dev defaults to a SQLite file (zero setup). For production, point this
# at a hosted Postgres instance (e.g. Neon or Supabase free tier):
# DATABASE_URL=postgresql://user:password@host/dbname
DATABASE_URL=sqlite:///./dev.db

# Signs the session cookie's JWT. Falls back to an insecure dev default locally;
# set a real random value in production (Render can auto-generate this).
JWT_SECRET=

# Comma-separated list of extra frontend origins allowed to call this API in
# production (e.g. your Vercel URL). localhost origins are always allowed.
CORS_ORIGINS=
